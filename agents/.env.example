# Claude API key used by the news and analysis agents
ANTHROPIC_API_KEY=
# Supabase connection string: Connect > Session pooler URI (the Direct connection is IPv6-only)
DATABASE_URL=
# Image agent (skipped unless all three are set)
# Recraft API key (recraft.ai), billed from prepaid credit
RECRAFT_API_KEY=
# Supabase project URL (Connect dialog, https://<ref>.supabase.co) and a secret key
# (Project Settings > API Keys, sb_secret_...)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
